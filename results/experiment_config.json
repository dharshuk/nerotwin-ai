{
  "project_name": "NeuroVision",
  "project_type": "web-based neurological screening prototype",
  "backend": {
    "framework": "Flask",
    "version": "3.1.3",
    "python": "3.10.8",
    "database": "SQLite"
  },
  "frontend": {
    "framework": "React",
    "version": "18.2.0",
    "build_tool": "react-scripts 5.0.1"
  },
  "target_task": "rule-based screening score generation from synthetic feature values",
  "labels_available": false,
  "labels_type": "none",
  "data_source": "synthetic numeric feature values sent to /user/test endpoint",
  "evaluation_protocol": {
    "trials": 5,
    "api_endpoint": "POST /user/test",
    "measurement": [
      "response time (ms)",
      "motor_score",
      "speech_score",
      "reaction_score",
      "neuro_risk_index",
      "risk_level"
    ]
  },
  "limitations": [
    "No clinical labels",
    "No trained ML model",
    "No real audio or video feature extraction in current pipeline",
    "No medical validation"
  ]
}
